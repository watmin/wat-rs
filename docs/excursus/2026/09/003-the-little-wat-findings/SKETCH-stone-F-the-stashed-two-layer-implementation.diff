+/// Excursus 003 stone F — LAYER 2 (runtime): a pure aggregate / `:wat::enum::Pure` enum built
+/// with a type parameter bound to an impure value is REFUSED, never built.
+///
+/// Layer 1 (`crate::check::impure_instantiation`) refuses every constructor call whose type
+/// argument it can see. It cannot see one inside a GENERIC function — `(Box :x v)` where `v : T`
+/// is `(Box :- [T])`, and refusing that would outlaw a truth (it is legal for every pure `T`). So
+/// the constructor itself judges the VALUE, and only for the fields whose declared type mentions
+/// a type parameter: every other field's type is concrete, and the containment rule already made
+/// it pure.
+///
+/// ⛔ Refuse, never coerce: the failure this exists for is `:wat::edn::write` turning the handle
+/// into `nil` with nothing reporting it. The raise carries `span` — the constructor form's own,
+/// which is the user's call site.
+fn refuse_impure_type_param_values(
+    type_key: &str,
+    type_params: &[String],
+    declared: &[(String, crate::types::TypeExpr)],
+    fields: &[Value],
+    types: &crate::types::TypeEnv,
+    span: &Span,
+) -> Result<(), EvalBreak> {
+    if type_params.is_empty() {
+        return Ok(());
+    }
+    fn mentions_param(t: &crate::types::TypeExpr, params: &[String]) -> bool {
+        use crate::types::TypeExpr;
+        match t {
+            TypeExpr::Path(p) => params.iter().any(|q| p.strip_prefix(':').unwrap_or(p) == q),
+            TypeExpr::Parametric { args, .. } => args.iter().any(|a| mentions_param(a, params)),
+            TypeExpr::Fn { args, ret } => {
+                args.iter().any(|a| mentions_param(a, params)) || mentions_param(ret, params)
+            }
+            TypeExpr::Tuple(es) => es.iter().any(|e| mentions_param(e, params)),
+            TypeExpr::Var(_) => false,
+        }
+    }
+    for ((fname, fty), value) in declared.iter().zip(fields) {
+        if !mentions_param(fty, type_params) {
+            continue;
+        }
+        if let Some(bad) = crate::runtime::first_impure_value(value, types) {
+            if let Ok(path) = std::env::var("WAT_STONE_F_CENSUS") {
+                use std::io::Write;
+                if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+                    let _ = writeln!(f, "L2\t{}\t{}\t{}\t{}", span, type_key, fname, bad.type_name());
+                }
+                continue;
+            }
+            return Err(RuntimeError::new(
+                span.clone(),
+                RuntimeErrorKind::TypeMismatch {
+                    op: format!("{type_key} (field :{fname})"),
+                    expected: "a pure value — a pure aggregate or :wat::enum::Pure enum cannot hold a \
+                               live resource, whatever its type parameter is bound to (declare the \
+                               type Impure — a struct, or :wat::enum::Impure — if it must)",
+                    got: Box::new(ValueSnapshot::of(bad)),
+                },
+            )
+            .into());
+        }
+    }
+    Ok(())
+}
