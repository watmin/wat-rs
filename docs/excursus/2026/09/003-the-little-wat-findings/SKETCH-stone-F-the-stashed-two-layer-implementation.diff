+/// Excursus 003 stone F — LAYER 2's question about a VALUE: does it hold, at any depth, a value
+/// that could not be reconstructed from EDN bytes? Returns the first such value found, so the
+/// refusal can name it; `None` means the value is pure data.
+///
+/// The value-level mirror of `crate::check::is_pure_type`, answered for what is actually THERE:
+/// - **Leaves** are impure exactly when [`Value::key_eligibility`] classes them
+///   `NeverAKey(InteriorMutable | OpaqueHandle)` — the same single source stone E's
+///   [`value_is_hashable`] uses, so the two walks cannot disagree about what a handle is. That
+///   class is every opaque handle, channel end, ML handle, stream, and callable (`fn` values,
+///   `clauses`, `extend_def`) — each is a `TypeExpr` `is_pure_type` also calls impure.
+/// - **A struct** (`Nature::Struct`) is impure whatever it holds — "a struct crosses NO comms".
+/// - **An enum** declared `:wat::enum::Impure` is impure whatever it holds (its purity is
+///   DECLARED, as `is_pure_type` reads it); a `Pure` one is judged by its fields.
+/// - **A stamped record** is pure without a walk: `AggregateValue::from_parts` stamps only when
+///   every field is `value_is_shallow` (scalars, stamped records, shallow enums).
+///
+/// ⛔ Exhaustive, no wildcard: a new `Value` variant must be classified here before it compiles.
+pub(crate) fn first_impure_value<'a>(v: &'a Value, types: &crate::types::TypeEnv) -> Option<&'a Value> {
+    match v {
+        Value::Vec(xs) | Value::Tuple(xs) => xs.iter().find_map(|x| first_impure_value(x, types)),
+        Value::wat__core__List(xs) => xs.iter().find_map(|x| first_impure_value(x, types)),
+        Value::wat__core__PersistentVector(pv) => pv.iter().find_map(|x| first_impure_value(x, types)),
+        Value::wat__std__HashSet(s) => s.iter().find_map(|x| first_impure_value(x, types)),
+        Value::wat__std__HashMap(m) => m
+            .iter()
+            .find_map(|(k, val)| first_impure_value(k, types).or_else(|| first_impure_value(val, types))),
+        Value::wat__core__PersistentMap(pm) => pm
+            .iter()
+            .find_map(|(k, val)| first_impure_value(k, types).or_else(|| first_impure_value(val, types))),
+        Value::Option(opt) => opt.as_ref().as_ref().and_then(|x| first_impure_value(x, types)),
+        Value::Result(res) => match res.as_ref() {
+            Ok(inner) | Err(inner) => first_impure_value(inner, types),
+        },
+        Value::Aggregate(a) => match a.nature {
+            crate::types::Nature::Struct | crate::types::Nature::Peer => Some(v),
+            crate::types::Nature::Record | crate::types::Nature::HolonRecord => {
+                if a.identity() != 0 {
+                    None
+                } else {
+                    a.fields.iter().find_map(|x| first_impure_value(x, types))
+                }
+            }
+        },
+        Value::Enum(e) => {
+            let declared_impure = matches!(
+                types.get(&e.type_path),
+                Some(crate::types::TypeDef::Enum(d)) if !d.purity.is_pure()
+            );
+            if declared_impure {
+                Some(v)
+            } else {
+                e.fields.iter().find_map(|x| first_impure_value(x, types))
+            }
+        }
+        Value::ForeignRecord(r) => r.fields.iter().find_map(|(_, x)| first_impure_value(x, types)),
+        Value::ForeignVariant(fv) => fv.fields.iter().find_map(|x| first_impure_value(x, types)),
+        Value::wat__core__clauses(_)
+        | Value::wat__core__extend_def(_)
+        | Value::bool(_)
+        | Value::i64(_)
+        | Value::u8(_)
+        | Value::f64(_)
+        | Value::String(_)
+        | Value::Unit
+        | Value::wat__core__keyword(_)
+        | Value::wat__core__fn(_)
+        | Value::holon__HolonAST(_)
+        | Value::wat__WatAST(_)
+        | Value::wat__kernel__Sender(_)
+        | Value::wat__kernel__Receiver(_)
+        | Value::RustOpaque(_)
+        | Value::io__IOReader(_)
+        | Value::io__IOWriter(_)
+        | Value::wat__kernel__HandlePool { .. }
+        | Value::wat__kernel__ChildHandle(_)
+        | Value::Vector(_)
+        | Value::OnlineSubspace(_)
+        | Value::Reckoner(_)
+        | Value::Engram(_)
+        | Value::EngramLibrary(_)
+        | Value::Hologram(_)
+        | Value::Instant(_)
+        | Value::Duration(_)
+        | Value::wat__core__Uuid(_)
+        | Value::wat__core__Char(_)
+        | Value::wat__core__Rational(_)
+        | Value::wat__core__BigInt(_)
+        | Value::wat__stream__Stream(_) => matches!(
+            v.key_eligibility(),
+            KeyEligibility::NeverAKey(NotAKeyReason::InteriorMutable | NotAKeyReason::OpaqueHandle)
+        )
+        .then_some(v),
+    }
+}
