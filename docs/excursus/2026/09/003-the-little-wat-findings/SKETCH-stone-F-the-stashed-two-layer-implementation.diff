+/// Excursus 003 stone F — what [`impure_instantiation`] found: the pure type, the field that
+/// would hold an impure value (`field` or `Variant.field`), and that field's type AFTER the
+/// type arguments were substituted in.
+pub(crate) struct ImpureInstantiation {
+    pub(crate) pure_type: String,
+    pub(crate) field: String,
+    pub(crate) field_ty: TypeExpr,
+}
+
+/// Excursus 003 stone F — **a type parameter does not launder impurity into a pure aggregate.**
+///
+/// [`validate_aggregate_containment`] judges a DECLARATION, where a field typed `:T` is still
+/// `:T` — and [`is_pure_type`]'s `None => true` arm calls a formal parameter pure by assumption.
+/// This is the other half of that assumption: at an INSTANTIATION `(Box :- [X])` the assumption
+/// is checked. Answers `Some` when `ty` is a pure aggregate (`Record`/`HolonRecord` nature) or a
+/// `:wat::enum::Pure` enum, instantiated with type arguments under which one of its fields'
+/// types is impure.
+///
+/// Three things this deliberately does NOT refuse, each a truth:
+/// - **An unresolved inference var** (`TypeExpr::Var`) is judged PURE: `is_pure_type` calls a
+///   `Var` impure, which here would refuse every constructor whose type argument is merely not
+///   yet known. A var is replaced by a pure placeholder before judging, so only an argument that
+///   is impure however the vars resolve is refused.
+/// - **A rigid type parameter of an enclosing generic fn** (`Path(":T")`) stays pure by
+///   `is_pure_type`'s own assumption — a generic fn building `(Box :- [T])` is legal for a pure
+///   `T`. The runtime constructor (layer 2, `crate::record::construct`) judges the value there.
+/// - **`:wat::core::Option` / `:wat::core::Result`.** They are declared `:wat::enum::Pure`, but
+///   they are the language's parametric CONTAINERS — `is_pure_type`'s own classification lists
+///   them beside `Vector`/`HashMap` as "pure iff all type args are pure" — and
+///   `(Result :- [(Lru :- [K V]) Fault])` is what `Lru/new` returns. Refusing them would outlaw
+///   the whole standard library; they are pure-if-args-pure exactly as `Vector` is.
+fn is_builtin_container_enum(key: &str) -> bool {
+    // A variant's singleton type (`:wat::core::Option.Some`) is registered as an enum of its own
+    // (`register_variant_types`); it is the same container, so it is judged by its base path.
+    let base = wat_reader::identifier::decompose_variant(key).map_or(key, |(b, _)| b);
+    base == ":wat::core::Option" || base == ":wat::core::Result"
+}
+
+pub(crate) fn impure_instantiation(ty: &TypeExpr, types: &TypeEnv) -> Option<ImpureInstantiation> {
+    use crate::types::{EnumVariant, TypeDef};
+    let TypeExpr::Parametric { head, args } = ty else {
+        return None;
+    };
+    let key = if head.starts_with(':') { head.clone() } else { format!(":{head}") };
+    let (params, fields): (&[String], Vec<(String, &TypeExpr)>) = match types.get(&key)? {
+        TypeDef::Aggregate(a) if a.nature.is_pure() => (
+            &a.type_params,
+            a.fields.iter().map(|(n, t)| (n.clone(), t)).collect(),
+        ),
+        TypeDef::Enum(e) if e.purity.is_pure() && !is_builtin_container_enum(&key) => {
+            let mut fs = Vec::new();
+            for v in &e.variants {
+                if let EnumVariant::Tagged { name: vname, fields } = v {
+                    for (fname, fty) in fields {
+                        fs.push((format!("{vname}.{fname}"), fty));
+                    }
+                }
+            }
+            (&e.type_params, fs)
+        }
+        _ => return None,
+    };
+    if params.is_empty() {
+        return None;
+    }
+    fn vars_as_pure(t: &TypeExpr) -> TypeExpr {
+        match t {
+            TypeExpr::Var(_) => TypeExpr::Path(":wat::core::nil".into()),
+            TypeExpr::Path(_) => t.clone(),
+            TypeExpr::Parametric { head, args } => TypeExpr::Parametric {
+                head: head.clone(),
+                args: args.iter().map(vars_as_pure).collect(),
+            },
+            TypeExpr::Fn { args, ret } => TypeExpr::Fn {
+                args: args.iter().map(vars_as_pure).collect(),
+                ret: Box::new(vars_as_pure(ret)),
+            },
+            TypeExpr::Tuple(es) => TypeExpr::Tuple(es.iter().map(vars_as_pure).collect()),
+        }
+    }
+    let mapping: HashMap<String, TypeExpr> = params
+        .iter()
+        .zip(args)
+        .map(|(p, a)| (p.clone(), vars_as_pure(a)))
+        .collect();
+    for (field, fty) in fields {
+        let field_ty = rename(fty, &mapping);
+        if !is_pure_type(&field_ty, types) {
+            return Some(ImpureInstantiation { pure_type: key, field, field_ty });
+        }
+    }
+    None
+}
