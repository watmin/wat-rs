;; rune:lint(red-by-design) — this is the REFUSE half of experiri's phantom-head calibration: an UNRESERVED namespace is rejected at load, which is exactly what proves the :wat::-prefixed cells (p1-p4, p6) are accepted by PREFIX rather than by leaf validation. If this file ever loads, the grid has stopped discriminating and L2-1 must be re-driven.
;; VIGILIA experiri — REFUSE CONTROL: the same invented leaf under a NON-reserved prefix.
;; `is_resolvable_call_head` has no prefix escape for `:vph::`, so resolve must refuse.
(:wat::core::defn :user::go [] -> :wat::core::i64
  (:vph::VIGILIA-NEVER-EXISTED-ANYWHERE 1 2))
