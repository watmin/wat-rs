+      (:wat::core::if has-tl?
+        (:wat::core::let [nxt    (:wat::core::first tl)
+                          rest1  (:wat::core::rest tl)
+                          has2?  (:wat::core::not (:wat::core::empty? rest1))]
+          (:wat::core::if (:wat::core::if (:wat::fix::binder? h) (:wat::fix::vector-node? nxt) false)
+            ;; `:- [` — the bracket's elements are types. Skip the vector as a
