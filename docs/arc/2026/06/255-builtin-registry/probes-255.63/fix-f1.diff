+;; fix-text-type-elems — elements of a `:- [` bracket are type position.
+;; A keyword converts with to-type-form. A nested list keeps its own head/`:-`
+;; lookahead via the ordinary node walk.
+(:wat::core::defn :wat::fix::fix-text-type-elems
+  [items <- (:wat::core::Vector :- [:wat::WatAST])
+   lines <- (:wat::core::Vector :- [:wat::core::String])
+   src   <- :wat::core::String]
+  -> (:wat::core::Vector :- [(:wat::core::Tuple :- [:wat::core::i64 :wat::core::String :wat::core::String])])
+  (:wat::core::if (:wat::core::empty? items)
+    (:wat::fix::empty-edits)
+    (:wat::core::let [h     (:wat::core::first items)
+                      tl    (:wat::core::rest items)
+                      edits (:wat::core::if (:wat::core::= (:wat::core::ast-kind h) "keyword")
+                              (:wat::fix::fix-text-leaf-edits h false false true lines src)
+                              (:wat::fix::fix-text-node-edits h false false lines src))]
+      (:wat::core::concat edits
+        (:wat::fix::fix-text-type-elems tl lines src)))))
 
 ;; fix-text-seq-edits — position-aware left-to-right walk over a child sequence.
 ;; Mirrors fix-seq's rule order; collects edits in ascending offset order.
+;; F1: a head keyword followed by `:-` and a vector is a type head (to-type-form).
