+                (:wat::fix::fix-text-seq-edits tl is-arrow? (:wat::fix::carry-rete-var? h prev-rete-var?) lines src)))))
+        (:wat::core::concat
+          (:wat::fix::fix-text-node-edits h prev-arrow? prev-rete-var? lines src)
+          (:wat::fix::empty-edits))))))
 
