+;; binder? — the parameterization marker `:-`, symbol or keyword.
+(:wat::core::defn :wat::fix::binder? [node <- :wat::WatAST] -> :wat::core::bool
+  (:wat::core::let [k (:wat::core::ast-kind node)]
+    (:wat::core::if (:wat::core::if (:wat::core::= k "symbol") true (:wat::core::= k "keyword"))
+      (:wat::core::= (:wat::core::ast-name node) ":-")
+      false)))
+
+;; vector-node? — a bracket form. The type-argument list after `:-`.
+(:wat::core::defn :wat::fix::vector-node? [node <- :wat::WatAST] -> :wat::core::bool
+  (:wat::core::= (:wat::core::ast-kind node) "vector"))
+
+;; type-slot-text — spelling of a keyword standing in a type position.
+;; `language-provided-spelling` reads the builtin registration (empty when the
+;; name is declared or a subsystem type). Declared names keep `to-symbol`
+;; (`:wat::core::Option` → `wat.core/Option`). A bare primitive falls through
+;; to `to-type-form`.
+(:wat::core::defn :wat::fix::type-slot-text [node <- :wat::WatAST] -> :wat::core::String
+  (:wat::core::let [s (:wat::keyword::language-provided-spelling node)]
+    (:wat::core::if (:wat::string::empty? s)
+      (:wat::core::if (:wat::fix::head-keyword? node)
+        (:wat::core::ast-name (:wat::keyword::to-symbol node))
+        (:wat::core::write-forms (:wat::keyword::to-type-form node)))
+      s)))
+
+;; reference-text — a call/value keyword. `:wat::WatAST` is `wat.type/AST`
+;; in every position (N-AST). Every other head keeps its declaring namespace.
+(:wat::core::defn :wat::fix::reference-text [node <- :wat::WatAST] -> :wat::core::String
+  (:wat::core::if (:wat::core::= (:wat::core::ast-name node) ":wat::WatAST")
+    "wat.type/AST"
+    (:wat::core::ast-name (:wat::keyword::to-symbol node))))
+
+;; type-slot-node — the in-memory twin of type-slot-text.
+(:wat::core::defn :wat::fix::type-slot-node [node <- :wat::WatAST] -> :wat::WatAST
+  (:wat::core::let [s (:wat::keyword::language-provided-spelling node)]
+    (:wat::core::if (:wat::string::empty? s)
+      (:wat::core::if (:wat::fix::head-keyword? node)
+        (:wat::keyword::to-symbol node)
+        (:wat::keyword::to-type-form node))
+      (:wat::core::symbol-node s))))
+
+;; reference-node — the in-memory twin of reference-text.
+(:wat::core::defn :wat::fix::reference-node [node <- :wat::WatAST] -> :wat::WatAST
+  (:wat::core::if (:wat::core::= (:wat::core::ast-name node) ":wat::WatAST")
+    (:wat::core::symbol-node "wat.type/AST")
+    (:wat::keyword::to-symbol node)))
+
