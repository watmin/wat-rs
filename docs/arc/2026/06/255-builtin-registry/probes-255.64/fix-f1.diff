 ;; fix-text-seq-edits — position-aware left-to-right walk over a child sequence.
-;; Mirrors fix-seq's rule order; collects edits in ascending offset order.
+;; A type head is a three-child `(Head :- […])` only when this list is itself
+;; in type position (`type-ctx?`). The same shape in value position is the
+;; empty constructor `(wat.core/Vector :- [T])` — Record.wat's foldl seed —
+;; and its head keeps the declaring namespace. A `defenum` name is followed
+;; by `:- [` and then by variants; the list is longer than three, so the name
+;; is not a type head either way.
 (:wat::core::defn :wat::fix::fix-text-seq-edits
   [items          <- (:wat::core::Vector :- [:wat::WatAST])
    prev-arrow?    <- :wat::core::bool
    prev-rete-var? <- :wat::core::bool
+   type-ctx?      <- :wat::core::bool
    lines          <- (:wat::core::Vector :- [:wat::core::String])
    src            <- :wat::core::String]
   -> (:wat::core::Vector :- [(:wat::core::Tuple :- [:wat::core::i64 :wat::core::String :wat::core::String])])
   (:wat::core::if (:wat::core::empty? items)
     (:wat::fix::empty-edits)
