+;; typealias-head? — `typealias`'s last child is a type, and it is not behind an arrow
+;; when the alias has no parameters (`(typealias Name (Vector :- [T]))`).
+(:wat::core::defn :wat::fix::typealias-head? [node <- :wat::WatAST] -> :wat::core::bool
+  (:wat::core::let [k (:wat::core::ast-kind node)]
+    (:wat::core::if (:wat::core::if (:wat::core::= k "symbol") true (:wat::core::= k "keyword"))
+      (:wat::core::let [n (:wat::core::ast-name node)]
+        (:wat::core::if (:wat::core::= n ":wat::core::typealias")
+          true
+          (:wat::core::= n "wat.core/typealias")))
+      false)))
 
