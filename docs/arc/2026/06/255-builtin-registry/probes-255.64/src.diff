+/// Process-wide `TypeEnv::with_builtins` for the codemod. The set is the
+/// registration, built once per thread.
+pub(crate) fn language_provided_surface(name: &str) -> Option<String> {
+    use std::cell::{Cell, RefCell};
+    thread_local! {
+        static BUILDING: Cell<bool> = const { Cell::new(false) };
+        static BUILTINS: RefCell<Option<TypeEnv>> = const { RefCell::new(None) };
+    }
+    // `TypeEnv::with_builtins` parses declarations, and that parse asks this
+    // function. A re-entrant ask is "not yet" — the registry is not finished —
+    // rather than a second build.
+    if BUILDING.with(|c| c.get()) {
+        return None;
+    }
+    let cached = BUILTINS.with(|slot| slot.borrow().clone());
+    let env = if let Some(env) = cached {
+        env
+    } else {
+        BUILDING.with(|c| c.set(true));
+        let env = TypeEnv::with_builtins();
+        BUILDING.with(|c| c.set(false));
+        BUILTINS.with(|slot| {
+            let mut guard = slot.borrow_mut();
+            if guard.is_none() {
+                *guard = Some(env.clone());
+            }
+        });
+        env
+    };
+    env.language_provided_surface_in(name)
+}
