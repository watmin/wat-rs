+/// `(wat.keyword/language-provided-spelling <keyword-node>)` → `wat.type/…`
+/// or `""`. The argument is evaluated, same as `to-symbol`: the codemod passes
+/// a node binding, not a keyword literal.
+pub fn eval_language_provided_spelling(
+    args: &[WatAST],
+    list_span: &crate::span::Span,
+    env: &Environment,
+    sym: &SymbolTable,
+) -> Result<crate::value::TrackedValue, RuntimeError> {
+    const OP: &str = ":wat::keyword::language-provided-spelling";
+    let v = require_one_arg(OP, args, env, sym, list_span)?;
+    let name = match &v {
+        Value::wat__WatAST(a) => match a.as_ref() {
+            WatAST::Keyword(s, _) => s.clone(),
+            WatAST::Symbol(id, _) => id.as_str().to_string(),
+            _ => {
+                return Err(RuntimeError::new(
+                    list_span.clone(),
+                    RuntimeErrorKind::MalformedForm {
+                        head: OP.into(),
+                        reason: "language-provided-spelling requires a Keyword or Symbol node".to_string(),
+                    },
+                ))
+            }
+        },
+        other => {
+            return Err(RuntimeError::new(
+                list_span.clone(),
+                RuntimeErrorKind::TypeMismatch {
+                    op: OP.into(),
+                    expected: ":wat::WatAST",
+                    got: Box::new(crate::runtime::ValueSnapshot::of(other)),
+                },
+            ))
+        }
+    };
+    let surface = crate::types::language_provided_surface(&name).unwrap_or_default();
+    Ok(crate::value::TrackedValue::new(
+        Value::String(std::sync::Arc::new(surface)),
+        crate::value::Provenance::RuntimeBuilt {
+            producer: OP,
+            call_span: list_span.clone(),
+        },
+    ))
+}
