+/// A type token may be a keyword, a `(…)` / `[…]` form, or a symbol
+/// (`wat.type/i64`, `wat.core/i64`). The reader check still follows.
+fn type_token_shape_ok(token: &str) -> bool {
+    token.starts_with(':')
+        || token.starts_with('(')
+        || token.starts_with('[')
+        || matches!(
+            wat_reader::parse_one_with_file(token, "<wat-doc type token>"),
+            Ok(wat_reader::WatAST::Symbol(_, _))
+        )
+}
