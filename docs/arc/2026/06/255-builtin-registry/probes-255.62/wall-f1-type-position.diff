 /// Any other node variant → `TypeError::MalformedTypeExpr` with a
 /// descriptive reason.
+/// F1: `wat.core/<builtin type>` is not a type spelling. Call position is
+/// untouched; this fires only from [`parse_type_node`] and [`parse_type_form`].
+fn forbidden_core_type_symbol(spelling: &str) -> Option<String> {
+    let (ns, name) = spelling.split_once('/')?;
+    if ns != "wat.core" || name.is_empty() || name.contains('/') {
+        return None;
+    }
+    let colon_free = format!("wat::core::{name}");
+    let colon = format!(":{colon_free}");
+    let hit = crate::runtime::is_builtin_primitive(&colon_free)
+        || crate::check::BARE_PRIMITIVES.iter().any(|(_, fq)| *fq == colon)
+        || crate::check::BARE_CONTAINER_HEADS
+            .iter()
+            .any(|(_, fq)| *fq == colon_free)
+        || name == "Value";
+    if hit { Some(name.to_string()) } else { None }
+}
+
+fn core_type_in_type_position(spelling: &str, name: &str, span: &Span) -> TypeError {
+    TypeError::new(
+        span.clone(),
+        TypeErrorKind::MalformedTypeExpr {
+            raw: spelling.into(),
+            reason: format!(
+                "type position refuses {spelling}; types live in wat.type (write wat.type/{name})"
+            ),
+        },
+    )
+}
