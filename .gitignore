/target
Cargo.lock

# Harness state — never operate on. See docs/COMPACTION-AMNESIA-RECOVERY.md § FM 7-bis.
.claude/worktrees/

# Ephemeral arc/stone cascade tooling (build → use → delete). Repo-local scratch
# pad — the sandbox firewall denies /tmp/. See docs/DUNGEON-CRAWL.md § cascade.
/tools/

# Coverage artifacts (arc 252 gate). LLVM_PROFILE_FILE emits *.profraw; an
# instrumented build that lingers makes plain `cargo test` drop default_*.profraw
# in CWD. The lcov is regenerated each gate run. Never commit either.
*.profraw
coverage.lcov
/coverage.lcov


# arc 278 #79 — the flake hunt writes full floor logs; the SCRIPT is tracked, its output is not
wat-scripts/hunt/out/

# arc 278 — scripts/floor.sh captures EVERY floor run (a red's arm must survive
# the read). The SCRIPT is tracked; its captures are not.
/.floor/

# arc 278 — preserved pre-change wat binaries for the STASH-DANCE bootstrap
# (wat/fix.wat:23-53). A 16MB artifact; kept on disk, never committed.
bootstrap/

# arc 278 — vigilia recast scratch (run dirs + probe output). The LOOP doctrine is
# tracked at docs/VIGILIA-LOOP.md; only its run output is scratch.
/tmp/
