;; ════════════════════════════════════════════════════════════════════════════
;;  AGGREGATE SHOWCASE — the model in user-forms (arc 293/294, the (b′)-Arm-1 shape).
;;
;;  Three holders declared by CONSTRAINT · a surface couples permissions(:holder) with
;;  utility(:features) · aggregates satisfy AMBIENTLY · passing follows the contravariant
;;  ladder · a FOREIGN type joins via extend-type (holder DERIVED + CHECKED) · Value is the
;;  unidirectional move-only hatch · to-record (data projection) · extend-surface (default impls).
;;
;;  STATUS: RED — the acceptance gate for the surface-kit (K0–K5). Idioms grounded against the
;;  PROBATUM tests/types/probe_arc293_acceptance_demo.wat (Vector = :wat::core::Vector; concat =
;;  :wat::core::string::concat; bare `nil` in value position).
;;
;;  Done-detector:  cargo wat wat-scripts/demos/aggregates/showcase.wat.disabled
;;  When GREEN: rename .wat.disabled -> .wat — the wat-scripts load gate then owns it forever.
;; ════════════════════════════════════════════════════════════════════════════

;; ── THE THREE HOLDERS (declared by their constraint) ──────────────────────────
(:wat::core::defstruct  :dev::Sensor  [id <- :wat::core::String  port <- :wat::core::i64])                          ; struct — never crosses
(:wat::core::defrecord  :dev::Reading [id <- :wat::core::String  value <- :wat::core::f64  at <- :wat::core::i64])  ; core   — edn-repr
(:wat::holon::defrecord :dev::Signal  [id <- :wat::core::String  at <- :wat::core::i64  samples <- :wat::core::Vector<wat::core::f64>]) ; holon — edn + VSA

;; ── THE SURFACES — permissions(:holder) × utility(:features) ──────────────────
(:wat::core::defsurface :dev::Identified  :holder :wat::core::Struct   :features [(id [self <- :dev::Identified] -> :wat::core::String)])                  ; widest: anything named
(:wat::core::defsurface :dev::Persistable :holder :wat::core::Record   :features [at <- :wat::core::i64])                                                 ; must be edn-repr
(:wat::core::defsurface :dev::Measurable  :holder :wat::holon::Record  :features [(holo [self <- :dev::Measurable] -> :wat::core::Vector<wat::core::f64>)]) ; must be a holon

;; ── a method backs an accessor: Signal supplies `holo` from its samples field ─
(:wat::core::defn :dev::Signal/holo [self <- :dev::Signal] -> :wat::core::Vector<wat::core::f64>
  (:dev::Signal/samples self))

;; ── FOREIGN type joins via extend-type — holder DERIVED + CHECKED ──  ◀ K1 GAP
(:wat::core::extend-type :wat::core::Vector :dev::Identified
  (id [self] -> :wat::core::String "vector"))

;; ── CONSUMERS — each uses ONE feature; blind to the rest ──────────────────────
(:wat::core::defn :dev::label   [x <- :dev::Identified]  -> :wat::core::String
  (:wat::core::string::concat "<" (:dev::Identified/id x) ">"))
(:wat::core::defn :dev::store!  [x <- :dev::Persistable] -> :wat::core::i64
  (:dev::Persistable/at x))
(:wat::core::defn :dev::compare [a <- :dev::Measurable  b <- :dev::Measurable] -> :wat::core::f64
  (:wat::holon::cosine (:dev::Measurable/holo a) (:dev::Measurable/holo b)))

;; ── Value — receive ANY value; never USE it; only MOVE it ─────────────────────
(:wat::core::defn :dev::archive!     [v <- :wat::core::Value] -> :wat::core::nil nil)
(:wat::core::defn :dev::dead-letter! [x <- :wat::core::Value] -> :wat::core::nil (:dev::archive! x))

;; ── THE DEMO ─────────────────────────────────────────────────────────────────
(:wat::core::defn :user::main [] -> :wat::core::nil
  (:wat::core::let
    [sensor  (:dev::Sensor  "s-7" 8080)
     reading (:dev::Reading "s-7" 21.5 1719000000)
     signal  (:dev::Signal  "s-7" 1719000000 (:wat::core::Vector :wat::core::f64 0.1 0.2 0.3))
     other   (:dev::Signal  "s-9" 1719000050 (:wat::core::Vector :wat::core::f64 0.1 0.2 0.4))]
    (:wat::core::do
      (:wat::kernel::pprintln (:dev::label sensor))                                     ; <s-7>  struct via the widest surface
      (:wat::kernel::pprintln (:dev::label reading))                                    ; <s-7>  core  (ladder: record -> struct-floor)
      (:wat::kernel::pprintln (:dev::label signal))                                     ; <s-7>  holon (ladder)
      (:wat::kernel::pprintln (:dev::label (:wat::core::Vector :wat::core::i64 1 2 3)))  ; <vector>  ◀ foreign via extend-type
      (:wat::kernel::pprintln (:dev::store! reading))                                   ; 1719000000  core -> core slot
      (:wat::kernel::pprintln (:dev::store! signal))                                    ; 1719000000  holon -> core slot (ladder)
      (:wat::kernel::pprintln (:dev::compare signal other))                             ; cosine of two holons
      (:dev::dead-letter! sensor)                                                       ; Value moves a struct
      (:dev::dead-letter! reading)                                                      ; ... a record
      (:dev::dead-letter! 42)                                                           ; ... an i64
      nil)))

;; ════════════════════════════════════════════════════════════════════════════
;;  THE KIT (K2–K5) — to-record (data projection UP the ladder) + extend-surface (default impls).
;;  Further-out targets; loaded + type-checked by this file even though main does not run them.
;; ════════════════════════════════════════════════════════════════════════════

;; a surface whose DATA lets a struct's values cross the wire (the struct itself never crosses):
(:wat::core::defsurface :dev::Wire :holder :wat::core::Record
  :features [id <- :wat::core::String  port <- :wat::core::i64])

;; project a Sensor (struct, in-locus) onto :dev::Wire → the macro-emitted :dev::Wire$record (portable):
(:wat::core::defn :dev::ship [s <- :dev::Sensor] -> :wat::core::nil
  (:dev::dead-letter! (:wat::core::to-record s :dev::Wire)))     ; ◀ K3 to-record → :dev::Wire$record {id port}

;; a surface carrying a DEFAULT method impl, written ONCE — the types come from the surface:
(:wat::core::defsurface :acc::Adder :holder :wat::core::Record
  :features [n <- :wat::core::i64                                                   ; attribute (data)
             (add [self <- :acc::Adder  x <- :wat::core::i64] -> :wat::core::i64)])  ; method sig — self is a normal binder

(:wat::core::extend-surface :acc::Adder                                  ; ◀ K5 macro → (extend-type :acc::Adder$record :acc::Adder …)
  (add [self x] (:wat::core::i64::+ (:acc::Adder/n self) x)))            ;   write the BODY only — WHERE ARE THE TYPES? the surface.
