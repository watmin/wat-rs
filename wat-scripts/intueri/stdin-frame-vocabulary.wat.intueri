;; stdin-frame-vocabulary.wat.intueri — arc 170 closure #4.
;;
;; THE DEFECT, in one line of shipped code (wat/kernel/services/stdio.wat:121):
;;
;;     ((:wat::io::IOReader::ReadFrameOutcome::Frame line)
;;        (:wat::kernel::StdIn::ReadLineResponse::Line line))
;;
;; It reads a FRAME and relabels it a LINE. A frame is one-or-more physical lines
;; accumulated until the buffer forms a complete EDN value (`read_framed_edn`,
;; src/edn/render.rs). Layer 1 is already honest; only Layer 2 still says "line".
;;
;; ── WHAT IS ALREADY RULED (anchors — do NOT propose changing these) ───────────
;;
;; `:wat::io::IOReader/read-line` is LIVE and CORRECT — it genuinely reads one
;; line, returns (Option :- [String]). src/types.rs:1001 already ruled the consequence:
;;   "that name is already spent with that meaning, so reusing it here would both
;;    lie and collide."
;; So the Layer-2 op CANNOT be called `read-line`. That half is settled.
;;
;; Already registered, frame-vocabulary, both honest:
;;   :wat::io::IOReader/read-frame
;;   :wat::io::IOReader::ReadFrameOutcome :: Frame | Eof | Stopped
;;   :wat::kernel::ReadFrameOutcome       :: Frame | Eof | Stopped
;;   (:wat::kernel::ReadlnOutcome :- [T])       :: Datum | Eof | Stopped
;;
;; ★ THE DENSITY QUESTION, and it is the reason this is cast rather than assumed:
;;   TWO `ReadFrameOutcome`s already exist at two namespaces. A naive Layer-2
;;   rename to `StdIn::ReadFrameResponse` would make a THIRD ReadFrame* type.
;;   FQDN-always means no collision — but does it still SPEAK? Or does the
;;   vocabulary need a word that distinguishes the SERVICE reply from the
;;   READER outcome? Weigh it; do not assume `read-frame` is the answer merely
;;   because Layer 1 uses it.
;;
;; ── THE FOUR SLOTS TO NAME ───────────────────────────────────────────────────

;; SLOT 1 — the service OP (a defsurface :features member).
;;   current: read-line     ← lies; and `read-line` is spent (see anchors)
(:wat::core::defsurface :wat::kernel::StdIn
  :nature :wat::kernel::Peer
  :features
  [(read-line [self <- :wat::kernel::StdIn  req <- :wat::kernel::StdIn::ReadLineRequest]
     -> :wat::kernel::StdIn::ReadLineResponse :max-request-bytes 524288)])

;; SLOT 2 — the REQUEST record.  current: ReadLineRequest
;; NOTE the field is already frame-honest: max-buffer-bytes, not max-line-bytes.
(:wat::core::defrecord :wat::kernel::StdIn::ReadLineRequest
  [max-buffer-bytes <- :wat::core::i64])

;; SLOT 3 — the RESPONSE enum.       current: ReadLineResponse
;; SLOT 4 — the SUCCESS variant.     current: ::Line   ← the actual lie
;;
;; The other four variants are the service contract and are NOT in scope:
;;   Eof · Stopped · RequestTooLarge · RequestMalformed
(:wat::core::defenum :wat::kernel::StdIn::ReadLineResponse :wat::enum::Pure
  :Line             [line <- :wat::core::String]   ;; ← carries a FRAME, named a line
  :Eof              []
  :Stopped          []
  :RequestTooLarge  [bytes <- :wat::core::i64  cap <- :wat::core::i64]
  :RequestMalformed [path <- :wat::core::String
                     expected <- :wat::core::String
                     got <- :wat::core::String])

;; ── THE CONSUMER, so the names are judged at their USE site, not in isolation ─
;; (wat/kernel/services/stdio.wat:262-276, the `readln` lowering path)
;;
;;   (:wat::core::match (:wat::kernel::StdIn/read-line peer
;;                        (:wat::kernel::StdIn::ReadLineRequest :max-buffer-bytes cap))
;;     ((:wat::kernel::StdIn::ReadLineResponse::Line line)            line)
;;     ((:wat::kernel::StdIn::ReadLineResponse::Eof)                  …)
;;     ((:wat::kernel::StdIn::ReadLineResponse::Stopped)              …)
;;     ((:wat::kernel::StdIn::ReadLineResponse::RequestTooLarge b c)  …)
;;     ((:wat::kernel::StdIn::ReadLineResponse::RequestMalformed p e g) …))
;;
;; ── SCOPE ────────────────────────────────────────────────────────────────────
;; 5 files, all INTERNAL. No user surface moves: `readln` / `println` / `eprintln`
;; are the user-facing stdio triad and were ruled to STAY. This is Layer 2 only.
