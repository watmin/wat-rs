; near-miss: eprintln with a non-wall arg stays
(:wat::core::defn :u::keep [] -> :wat::core::nil
  (:wat::kernel::eprintln "dying…"))
(:wat::core::defn :u::lost [] -> :wat::core::nil
  (:wat::kernel::eprintln (:wat::kernel::Failure/message c)))
(:wat::core::defn :u::closed [] -> :wat::core::nil
  (:wat::kernel::eprintln "recv': peer closed"))
