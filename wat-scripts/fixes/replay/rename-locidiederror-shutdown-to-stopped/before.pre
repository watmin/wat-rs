; near-miss: other LociDiedError variants stay
(:wat::core::defn :u::keep [] -> :wat::core::nil :wat::kernel::LociDiedError::Panic)
(:wat::core::defn :u::hit [x <- :wat::kernel::LociDiedError] -> :wat::core::String
  (:wat::core::match x
    (:wat::kernel::LociDiedError::Shutdown "WRONG:Shutdown")
    (_ "other")))
