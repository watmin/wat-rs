; near-miss: a wrap whose inner scrutinee is not __recv stays
(:wat::core::defn :u::keep [x <- :wat::core::i64] -> :wat::core::i64
  (:wat::core::match x
    ((:wat::kernel::RecvOutcome::Message y) y)
    ((:wat::kernel::RecvOutcome::Lost __cause) 0)
    (:wat::kernel::RecvOutcome::Closed 0)))
(:wat::core::defn :u::hit [x <- :wat::core::i64] -> :wat::core::i64
  (:wat::core::match x
    ((:wat::kernel::RecvOutcome::Message __recv) (:wat::core::match __recv
      ((:u::AdminResp::Ok v) v)
      ((:u::AdminResp::Err e) 0)))
    ((:wat::kernel::RecvOutcome::Lost __cause) 0)
    (:wat::kernel::RecvOutcome::Closed 0)))
