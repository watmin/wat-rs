(:wat::core::defenum :usr::Shape :wat::enum::Pure
  :Circle [r <- :wat::core::i64]
  :Dot [])

; near-miss: already-map ctor stays (header: a single Map argument is already migrated)
(:wat::core::defn :user::keep [] -> :wat::core::nil
  (:wat::kernel::println (:usr::Shape::Circle {:r 1})))

(:wat::holon::defrecord :myapp::Point [x <- :wat::core::i64 y <- :wat::core::i64])
(:wat::core::defn :t::work [x <- :wat::core::i64 & [n <- :wat::core::i64]] -> :wat::core::i64 x)
(:wat::core::defenum)
(:wat::core::defn :user::main [] -> :wat::core::nil
  (:wat::kernel::println (:usr::Shape::Dot))
  (:wat::kernel::println (:usr::Shape::Circle 2))
  (:wat::kernel::println (:myapp::Point 1 2)))
; parent and child declare :t::M with DIFFERENT fields
(:wat::core::defenum :t::M :wat::enum::Pure
  :A [x <- :wat::core::i64])
(:wat::core::defn :fix::parent [] -> :t::M
  (:t::M::A 1))
(:wat::core::defn :fix::child-host [] -> :wat::core::nil
  (:wat::core::forms
    (:wat::core::defenum :t::M :wat::enum::Pure
      :A [y <- :wat::core::i64 z <- :wat::core::i64])
    (:wat::core::defn :inner::go [] -> :t::M
      (:t::M::A 1 2))))
