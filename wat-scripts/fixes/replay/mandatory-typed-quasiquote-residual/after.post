; near-miss: PersistentVector is NOT a mandatory-typed ctor
(:wat::core::defmacro :u::pv [ty <- :wat::WatAST] -> :wat::WatAST
  `(:wat::core::PersistentVector ~ty))
(:wat::core::defmacro :u::m [coords-ty-kw <- :wat::WatAST coords-sym <- :wat::WatAST] -> :wat::WatAST
  `(:wat::core::Vector :- [~coords-ty-kw] ~coords-sym))
