; near-miss: cond is not match — header: cond is not touched
(:wat::core::defn :fix::c [x <- :wat::core::i64] -> :wat::core::i64
  (:wat::core::cond (x x) (_ 0)))
; near-miss: a Vector arm is already migrated
(:wat::core::defn :fix::keep [x <- :wat::core::i64] -> :wat::core::i64
  (:wat::core::match x
    [already already]))
(:wat::core::defn :fix::hb [x <- :wat::core::i64] -> :wat::core::i64
  (:wat::core::match x
    [n n] [_ 0]))
(:wat::core::defenum :usr::E :wat::enum::Pure
  :Variant [a <- :wat::core::i64 b <- :wat::core::i64]
  :Unit [])
(:wat::core::defn :fix::mv [x <- :usr::E] -> :wat::core::i64
  (:wat::core::match x
    [:usr::E::Variant {:a a :b b} a]
    [:usr::E::Unit {} 0]))
; nested-program: type declared only inside forms
(:wat::core::defn :fix::np [x <- :wat::core::i64] -> :wat::core::i64
  (:wat::core::let [_ (:wat::core::forms
                        (:wat::core::defenum :inner::E :wat::enum::Pure
                          :V [a <- :wat::core::i64]))]
    (:wat::core::match x
      ((:inner::E::V a) a)
      [_ 0])))
