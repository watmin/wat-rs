; near-miss: cond is not match — header: cond is not touched
(:wat::core::defn :fix::c [x <- :wat::core::i64] -> :wat::core::i64
  (:wat::core::cond (x x) (_ 0)))
; near-miss: a Vector arm is already migrated
(:wat::core::defn :fix::keep [x <- :wat::core::i64] -> :wat::core::i64
  (:wat::core::match x
    [already already]))
(:wat::core::defn :fix::hb [x <- :wat::core::i64] -> :wat::core::i64
  (:wat::core::match x
    (n n) (_ 0)))
(:wat::core::defenum :usr::E :wat::enum::Pure
  :Variant [a <- :wat::core::i64 b <- :wat::core::i64]
  :Unit [])
(:wat::core::defn :fix::mv [x <- :usr::E] -> :wat::core::i64
  (:wat::core::match x
    ((:usr::E::Variant a b) a)
    (:usr::E::Unit 0)))
; nested-program: type declared only inside forms (used outside — parent door)
(:wat::core::defn :fix::np [x <- :wat::core::i64] -> :wat::core::i64
  (:wat::core::let [_ (:wat::core::forms
                        (:wat::core::defenum :inner::E :wat::enum::Pure
                          :V [a <- :wat::core::i64]))]
    (:wat::core::match x
      ((:inner::E::V a) a)
      (_ 0))))
; parent and child declare :t::M with DIFFERENT fields
(:wat::core::defenum :t::M :wat::enum::Pure
  :A [x <- :wat::core::i64])
(:wat::core::defn :fix::parent [m <- :t::M] -> :wat::core::i64
  (:wat::core::match m
    ((:t::M::A x) x)))
(:wat::core::defn :fix::child-host [] -> :wat::core::nil
  (:wat::core::forms
    (:wat::core::defenum :t::M :wat::enum::Pure
      :A [y <- :wat::core::i64 z <- :wat::core::i64])
    (:wat::core::defn :inner::go [m <- :t::M] -> :wat::core::i64
      (:wat::core::match m
        ((:t::M::A y z) y)))))
