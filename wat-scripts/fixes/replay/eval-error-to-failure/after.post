(:wat::core::defn :u::row [] -> (:wat::core::Result :- [:wat::core::i64 :wat::kernel::Failure]) (:wat::eval-ast! :- [:wat::core::i64] program))
(:wat::core::defn :u::msg [e <- :wat::kernel::Failure] -> :wat::core::String (:wat::kernel::Failure/message e))
(:wat::core::defn :u::kind [e <- :wat::kernel::Failure] -> :wat::core::String (:wat::core::type (:wat::kernel::Failure/error e)))
