; near-miss: already-wrapped connect' stays
(:wat::core::defn :u::keep [a <- :wat::core::i64] -> :wat::core::i64
  (:wat::core::match (:wat::kernel::connect' a)
    ((:wat::kernel::ConnectOutcome::Connected p) p)
    ((:wat::kernel::ConnectOutcome::Refused c) 0)
    ((:wat::kernel::ConnectOutcome::Rejected c) 0)
    ((:wat::kernel::ConnectOutcome::Failed c) 0)))
(:wat::core::defn :u::hit [a <- :wat::core::i64] -> :wat::core::i64
  (:wat::kernel::connect' a))
