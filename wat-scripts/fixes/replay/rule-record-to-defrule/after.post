; near-miss: already defrule stays
(:wat::rete::defrule :wsh::keep
  :when [(:wsh::Req (?k <- :k))]
  :then [(:wsh::Hit ?k)])
(:wat::rete::defrule :arith
  :when
  [(:wsh::Req (?k <- :k) (?c <- :client) (?n <- :name) (?t <- :tags) (?l <- :limit)) (:wat::rete::where
                                (:wat::core::= 3
                                  (:wat::core::i64::- ?k
                                    (:wat::core::i64::* (:wat::core::i64::/ ?k 10) 10))))]
  :then
  (:wat::rete::insert (:wsh::Hit ?k)))
