; near-miss: bare nth stays; bare first of a non-drop stays
(:wat::core::defn :u::keep [xs <- (:wat::core::Vector :- [:wat::core::i64])] -> :wat::core::i64
  (:wat::core::nth xs 0))
(:wat::core::defn :u::keep2 [xs <- (:wat::core::Vector :- [:wat::core::i64])] -> :wat::core::i64
  (:wat::core::first xs))
(:wat::core::defn :wat::deporder::defined-name
  [form <- :wat::WatAST]
  -> :wat::core::String
  (:wat::core::let [ch   (:wat::core::ast->children form)
                    name-node (:wat::core::first (:wat::core::drop ch 1))]
    (:wat::core::ast-name name-node)))
