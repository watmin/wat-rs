    (:wat::kernel::spawn-thread
      (:wat::core::fn [self <- (:wat::kernel::Peer :- [wat.type/i64 wat.type/i64])] -> wat.type/nil nil)
      (:wat::core::fn [] -> wat.type/Record (:wat::program::EmptyEnv)))
