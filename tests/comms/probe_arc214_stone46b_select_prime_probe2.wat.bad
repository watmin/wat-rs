;; Declaring the select' result as :String over i64-peers MUST fail at check.
;; startup_from_file on this file is expected to return Err.

(:wat::core::defn :user::bad [] -> :wat::core::String
  (:wat::core::let [p (:wat::kernel::spawn-program (:wat::spawn::thread)
                        (:wat::core::fn [self <- (:wat::kernel::ThreadSelfPeer :- [:wat::core::i64 :wat::core::i64])] -> :wat::core::nil
                          (:wat::kernel::send self (:wat::kernel::recv self))))]
    (:wat::kernel::select [p])))

