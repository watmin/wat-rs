;; Negative fixture: unknown field in binding clause → check error.
;; Used by test: rejects_unknown_field

(:wat::core::defstruct :test::PaperResolved
  [outcome <- wat.type/String
   grace-residue <- wat.type/f64])
(:wat::core::defn :t::probe [p <- :test::PaperResolved] -> wat.type/bool
  (:wat::form::matches? p
    (:test::PaperResolved
      (= ?o :unknown-field))))
