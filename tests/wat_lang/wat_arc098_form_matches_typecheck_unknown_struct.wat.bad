;; Negative fixture: unknown struct type in pattern → check error.
;; Used by test: rejects_unknown_struct_type

(:wat::core::defstruct :test::PaperResolved
  [outcome <- wat.type/String
   grace-residue <- wat.type/f64])
(:wat::core::defn :t::probe [p <- :test::PaperResolved] -> wat.type/bool
  (:wat::form::matches? p
    (:test::DoesNotExist
      (= ?o :outcome))))
