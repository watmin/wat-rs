#wat.doc/Row {
  :doc "`(:wat::rete::step-payload session alpha-id bindings sfact supporting) -> :wat::rete::DerivationStep`\n\n        Arc 278 Stone P12c — the explain payload builder. Given one (sfact, alpha-id) match edge\n        from a Token's matches chain, builds the full `DerivationStep` payload:\n\n        - **pattern**: the matched condition's fact-type FQDN (AlphaNode tests[0] head keyword).\n        - **bindings** (per-step): the binder-clause vars that THIS condition bound, projected\n          from the token's accumulated bindings.\n        - **constraints**: the rule's satisfied predicates with bound values substituted:\n          `(:wat::rete::i64::< -5 0)` from `(:wat::rete::i64::< ?c 0)` with `?c=-5`.\n\n        **Faithfulness by construction**: `classify_rete_clause` + `resolve_operand` reconstruct\n        the matched clause for the payload. Native fire matches via `exec_compiled_with_key_ids`\n        (STOP-1), not `alpha_match_inner` (the oracle). Substituted values still cannot drift\n        from the classifier's spelling of what matched.\n\n        Arc 255 Stone P6-c-W5c — moved verbatim into `#[wat_intrinsic]` with its real (5) arity\n        declared; the hand-rolled `args.len() != 5` guard this wave retires lived right here.\n\n        **Purity ground:** all five args are evaluated by ordinary call-by-value (not itself an\n        effect — the same shape `alpha-match`'s wrapper is Pure for). Past that, the body only reads\n        already-evaluated values: `session_network`/`alpha_cond_of` read the session's compiled\n        network, `classify_rete_clause`/`resolve_operand` are pure structural walks (the same ones\n        `step-payload`'s own doc calls \"faithfulness by construction\"), and the two `OnceLock`s\n        (`STEP_CLASS_FQDN`, `derivation_step_names`) cache a fixed, compile-time-constant class name\n        and field-name table process-wide — the same boilerplate pattern already used by `export.rs`\n        (Effectful) and `purity.rs`'s pure axis predicates alike, so it is infrastructure, not a\n        per-call effect. No `eval_inner`/`apply_function` on caller-supplied code anywhere in this\n        body. The built `DerivationStep` record is freshly allocated and returned to the caller;\n        nothing outlives the call beyond the two process-wide constant caches."
  :added "1.0.0"
  :purity :wat.runtime.Purity/Pure
  :determinism :wat.runtime.Determinism/Deterministic
  :totality :wat.runtime.Totality/Unreviewed
  :expand-time :wat.runtime.ExpandTime/Unreviewed
  :category :wat.runtime.Category/Transform
  :args [
    [session :wat.rete/Session "the compiled session (network read via `session_network`)"]
    [alpha_id :wat.core/i64 "the AlphaNode id for this condition"]
    [bindings :wat.core/PersistentMap "the token's accumulated bindings"]
    [sfact :wat.core/Record "the supporting fact for this edge"]
    [supporting :wat.rete/DerivationNode "the pre-computed recursive node for `sfact`"]
  ]
  :ret [:wat.rete/DerivationStep "the per-edge explain payload (pattern, per-step bindings, substituted constraints, supporting)"]
  :examples [
    [
      (
        :wat.core/do
        (
          :wat.core/defrecord
          :probe/StepPayloadExampleTemp
          [celsius <- :wat.core/i64]
        )
        (
          :wat.core/defrecord
          :probe/StepPayloadExampleResult
          [celsius <- :wat.core/i64]
        )
        (
          :wat.rete/defrule
          :probe/step-payload-example-rule
          :when
          [
            (
              :probe/StepPayloadExampleTemp
              (?c <- :celsius)
              (:wat.rete.i64/< ?c 20)
            )
          ]
          :then
          [
            (:probe/StepPayloadExampleResult ?c)
          ]
        )
        (
          :wat.core/let
          [
            rules
            (:wat.rete/collect-rules :probe)
            session
            (:wat.rete/compile rules)
            session
            (
              :wat.rete/insert
              session
              (:probe/StepPayloadExampleTemp :celsius 10)
            )
            ex
            (:wat.rete/fire-rules-explain session)
            support
            (:wat.rete.Explained/support ex)
            result
            (:probe/StepPayloadExampleResult :celsius 10)
            sv
            (
              :wat.core.Option/expect
              (:wat.map/get support result)
              "sv"
            )
            tok
            (:wat.rete.Support/token sv)
            matches
            (:wat.rete.Token/matches tok)
            bindings
            (:wat.rete.Token/bindings tok)
            m0
            (
              :wat.core.Option/expect
              (:wat.core/get matches 0)
              "m0"
            )
            sfact
            (:wat.core/first m0)
            alpha-id
            (:wat.core/second m0)
            sess
            (:wat.rete.Explained/session ex)
            supporting
            (:wat.rete/explain ex sfact)
          ]
          (:wat.rete/step-payload sess alpha-id bindings sfact supporting)
        )
      )
      (
        :wat.rete/DerivationStep
        :supporting
        (
          :wat.rete/DerivationNode
          :fact
          (:probe/StepPayloadExampleTemp :celsius 10)
          :rule
          :wat.core.Option/None
          :via
          (:wat.core/PersistentVector)
        )
        :pattern
        "probe::StepPayloadExampleTemp"
        :bindings
        (:wat.core/PersistentMap "?c" 10)
        :constraints
        (
          :wat.core/PersistentVector
          (
            :wat.core/quote
            (:wat.rete.i64/< 10 20)
          )
        )
      )
    ]
  ]
}
