;; tests/collection/probe_hashmap_ctor_vector_symmetric_p6.wat.bad
;; Probe 6: wrong value type must fail type-check.
(:wat::core::defn :user::compute [] -> wat.type/i64
  (:wat::core::let
    [m (wat.type/HashMap :- [wat.type/keyword wat.type/i64]
          :foo "not-an-i64")]
    (:wat::core::match (:wat::core::get m :foo) 
      [:wat::core::Option.Some {:value v} v]
      [:wat::core::Option.None {} -1])))
