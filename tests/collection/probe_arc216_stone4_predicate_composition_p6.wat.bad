;; tests/collection/probe_arc216_stone4_predicate_composition_p6.wat.bad
;; Probe 6: to-holon on nested Fn type must fail at check with TypeMismatch.
(:wat::core::defn :user::compute [] -> wat.type/nil
  (:wat::core::let
    [g (:wat::core::fn [n <- wat.type/i64] -> wat.type/i64
          (:wat::i64::+ n 1))]
    (:wat::holon::to-holon g)))
