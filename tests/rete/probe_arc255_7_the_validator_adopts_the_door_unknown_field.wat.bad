;; 255.7 — a converted :then head with a bad FIELD is still UnknownField, not skipped.
(:wat::core::defrecord :weather::ColdAndWindy [location <- :wat::core::String])
(:wat::rete::defrule :weather::bad-field
  :when [(weather/ColdAndWindy (?loc :- :location))]
  :then [(weather/ColdAndWindy :nope ?loc)])
