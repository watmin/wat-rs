;; NEGATIVE — i64 into a String field. ARM A of DESIGN-STONE-the-then-block-never-checked-its-operand.
;; Constructor `(:user::Box :label 42)` is already REFUSED; the :then door was not.
(:wat::core::defrecord :fit::Box [label <- :wat::core::String])
(:wat::core::defrecord :fit::Num [n <- :wat::core::i64])

(:wat::rete::defrule :fit::arm-a
  :when [(:fit::Num (?n <- :n))]
  :then [(:fit::Box :label ?n)])

(:wat::core::defn :user::main [] -> :wat::core::nil nil)
