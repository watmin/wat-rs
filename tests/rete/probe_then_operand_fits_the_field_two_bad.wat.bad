;; NEGATIVE — two mismatched operands on one rule. Both must be reported (batch, do not bail).
(:wat::core::defrecord :fit::Box [a <- wat.type/String b <- wat.type/String])
(:wat::core::defrecord :fit::Num [n <- wat.type/i64 m <- wat.type/i64])

(:wat::rete::defrule :fit::two
  :when [(:fit::Num (?n :- :n) (?m :- :m))]
  :then [(:fit::Box :a ?n :b ?m)])

(:wat::core::defn :user::main [] -> wat.type/nil nil)
