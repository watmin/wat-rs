;; tests/types/probe_arc293_structural_surface_missing.wat.bad — negative fixture
;;
;; Arc 293.3-core — a struct MISSING the surface member must FAIL.

(:wat::core::defsurface :geo::Shape
  :nature wat.type/Struct
  :features [color <- wat.type/String])

(:wat::core::defstruct :geo::Bare
  [other <- wat.type/i64])

(:wat::core::defn :geo::accepts-shape [s <- :geo::Shape] -> wat.type/bool
  true)

(:wat::core::defn :user::main [] -> wat.type/bool
  (:geo::accepts-shape (:geo::Bare 42)))
