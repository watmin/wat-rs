;; newtype_distinct_newtypes.wat.bad — two newtypes over same inner stay distinct. Must FAIL.
(:wat::core::newtype :my::trading::Price :wat::core::f64)
(:wat::core::newtype :my::trading::Amount :wat::core::f64)
(:wat::core::defn :my::trading::price-pretty [p <- :my::trading::Price] -> :wat::core::String (:wat::f64::to-string (:my::trading::Price/0 p)))
(:wat::core::defn :my::probe [] -> :wat::core::String
  (:wat::core::let
    [a (:my::trading::Amount 50.0)]
    (:my::trading::price-pretty a)))
