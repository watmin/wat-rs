(:wat::core::defn :user::eq-generic :- [[T :< :wat::core::Equatable]] [a <- :T b <- :T] -> wat.type/bool
  (:wat::core::= a b))

(:wat::core::defn :user::main [] -> wat.type/nil
  (:user::eq-generic
    (:wat::core::fn [x <- wat.type/i64] -> wat.type/i64 x)
    (:wat::core::fn [y <- wat.type/i64] -> wat.type/i64 y)))
