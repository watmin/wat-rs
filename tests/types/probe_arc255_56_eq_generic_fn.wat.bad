(:wat::core::defn :user::eq-generic :- [[T :< :wat::core::Equatable]] [a <- :T b <- :T] -> :wat::core::bool
  (:wat::core::= a b))

(:wat::core::defn :user::main [] -> :wat::core::nil
  (:user::eq-generic
    (:wat::core::fn [x <- :wat::core::i64] -> :wat::core::i64 x)
    (:wat::core::fn [y <- :wat::core::i64] -> :wat::core::i64 y)))
