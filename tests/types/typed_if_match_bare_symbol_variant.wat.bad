;; typed_if_match_bare_symbol_variant.wat.bad — bare-symbol user variant pattern emits hint. Must FAIL.
(:wat::core::defn :user::compute [] -> :wat::core::String
  (:wat::core::let
    [handle
      (:wat::kernel::spawn-thread
        (:wat::core::fn
          [_in <- (:wat::kernel::Receiver :- [:wat::core::nil])
           _out <- (:wat::kernel::Sender :- [:wat::core::nil])]
           -> :wat::core::nil
          ()))
     result
      (:wat::kernel::Thread/drain-and-join handle)
     chain
      (:wat::core::match result 
        ((:wat::core::Ok _)  (:wat::core::panic! "test wants Err"))
        ((:wat::core::Err e) e))
     err
      (:wat::core::match (:wat::core::first chain) 
        ((:wat::core::Some e) e)
        (:wat::core::None    (:wat::core::panic! "expected non-empty chain")))]
    (:wat::core::match err 
      ((Panic m)        m)
      ((RuntimeError m) m)
      (:wat::kernel::LociDiedError::Disconnected "disc"))))
