;; ord_struct.wat.bad — Struct not in orderable class. Must FAIL.
(:wat::core::defstruct :my::Point
  [x <- wat.type/i64
   y <- wat.type/i64])
(:wat::core::defn :user::compute [] -> wat.type/bool
  (:wat::core::let
    [p (:my::Point :x 1 :y 2)
     q (:my::Point :x 3 :y 4)]
    (:wat::core::< p q)))
