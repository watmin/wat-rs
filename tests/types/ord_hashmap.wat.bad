;; ord_hashmap.wat.bad — HashMap not in orderable class; must fail at check. Must FAIL.
(:wat::core::defn :user::compute [] -> wat.type/bool
  (:wat::core::let
    [m1 (wat.type/HashMap :- [wat.type/String wat.type/i64] "a" 1)
     m2 (wat.type/HashMap :- [wat.type/String wat.type/i64] "b" 2)]
    (:wat::core::< m1 m2)))
