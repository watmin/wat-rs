;; Stone 118.3-B / 255.22 — NEGATIVE row: a family with NO `extend-type` edge to
;; `:wat::core::Seqable` (a HashMap) offers no candidate target. Must be refused at check.
(:wat::core::defn :t118b::count-of :- [T] [s <- (:wat::core::Seqable :- [T])] -> wat.type/i64
  (:wat::core::length (:wat::core::into [] (:wat::core::Seqable/seq s))))

(:wat::core::defn :t::count-map [] -> wat.type/i64
  (:t118b::count-of (wat.type/HashMap :- [wat.type/String wat.type/i64] "a" 1)))
