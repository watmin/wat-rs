;; Negative fixture: spawn-program' :thread declared as (Process' :- [...]) return — must be a CHECK ERROR.
(:wat::core::defn :user::mk-cross [] -> (:wat::kernel::Process :- [wat.type/i64 wat.type/i64])
  (:wat::kernel::spawn-program (:wat::spawn::thread)
    (:wat::core::fn [self <- (:wat::kernel::Peer :- [wat.type/i64 wat.type/i64])] -> wat.type/nil
      (:wat::kernel::send self (:wat::kernel::recv self)))))
