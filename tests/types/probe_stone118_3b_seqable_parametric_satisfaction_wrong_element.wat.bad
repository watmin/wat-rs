;; Stone 118.3-B / 255.22 — NEGATIVE row: the swap-gate. A `(Vector :- [String])` offers
;; `(Seqable :- [String])`, which does not unify with a concrete `(Seqable :- [i64])` bound.
;; Must be refused at check.
(:wat::core::defn :t118b::sum-of [s <- (:wat::core::Seqable :- [wat.type/i64])] -> wat.type/i64
  (:wat::core::foldl (:wat::core::fn [acc <- wat.type/i64 x <- wat.type/i64] -> wat.type/i64
                       (:wat::core::+ acc x))
                     0
                     (:wat::core::into [] (:wat::core::Seqable/seq s))))

(:wat::core::defn :t::sum-strings [] -> wat.type/i64
  (:t118b::sum-of (wat.type/Vector :- [wat.type/String] "a" "b")))
