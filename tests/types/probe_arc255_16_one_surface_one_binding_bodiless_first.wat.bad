;; Stone 255.16 — a type binds a parametric surface once (arc 255).
(:wat::core::defrecord :probe::Shared [a <- wat.type/i64])
(:wat::core::defrecord :probe::Wire [b <- wat.type/String])
(:wat::core::defsurface :probe::Loc :- [T] :nature wat.type/Struct
  :features [(transport [self <- (:probe::Loc :- [T])] -> :T)])
(:wat::core::defrecord :probe::Both [q <- wat.type/i64])
;; REFUSED at registration — ORDER-INDEPENDENCE: the bodiless binding arrives FIRST, the bodied
;; one second; the second is refused exactly as in the bodied-first order (255.15's ambiguity
;; fixture, now this stone's other negative row).
(:wat::core::extend-type :probe::Both (:probe::Loc :- [:probe::Wire]))
(:wat::core::extend-type :probe::Both (:probe::Loc :- [:probe::Shared]) (transport [self] (:probe::Shared :a 1)))
