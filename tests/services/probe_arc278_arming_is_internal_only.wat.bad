;; MUST NOT LOAD — a `defservice` handler arms a PUBLIC (client-facing) op via `Alarm`.
;;
;; BRIEF-arming-is-internal-only.md: an alarm has no client — when the timer fires, the
;; handler runs with a TIMER in the `idx` slot, not a client, so only an op *declared* to
;; have no client (INTERNAL — its `<service>::Op` variant name begins with `-`,
;; wat/service.wat:876-892) may be armed. Before this rule, this exact form (`:op` built from
;; the explicit `<service>::Op::Bump` ctor) `--check`ed clean and, when RUN with a mutating
;; witness, fired from the timer, mutated durable state, and its reply went nowhere with
;; nothing reported — proven by run, `docs/arc/2026/06/278-rules-engine/DESIGN-STONE-the-call-context.md`
;; § "RUN 2026-08-09". `bump` is PUBLIC (on `:satisfies`, no leading dash) — arming it in
;; `start` (below) is the offending form.
;;
;; Its control (`_control.wat`) is IDENTICAL but for that one `:op` expression in `start` —
;; it arms `-tick` (INTERNAL) instead — and MUST load (R59 `NISI FRANGAS, NIHIL PROBAS`:
;; without the control, this RED would prove only "something in the fixture is bad", not
;; "exactly the public-op arm is refused"). Both `bump` (public) and `-tick` (internal) are
;; declared as real impls in BOTH files so the only difference is which op `start` arms.
(:wat::core::defsurface :probe::Tick2 :nature :wat::kernel::Peer
  :messages
  [(:wat::core::defrecord :probe::Tick2::StartRequest [])
   (:wat::core::defenum :probe::Tick2::StartResponse :wat::enum::Pure
     :Ok               []
     :RequestTooLarge  [bytes <- :wat::core::i64  cap <- :wat::core::i64]
     :RequestMalformed [path <- (:wat::core::Vector :- [:wat::core::String])  expected <- :wat::core::String  got <- :wat::core::String])
   (:wat::core::defrecord :probe::Tick2::BumpRequest [])
   (:wat::core::defenum :probe::Tick2::BumpResponse :wat::enum::Pure
     :Ok               []
     :RequestTooLarge  [bytes <- :wat::core::i64  cap <- :wat::core::i64]
     :RequestMalformed [path <- (:wat::core::Vector :- [:wat::core::String])  expected <- :wat::core::String  got <- :wat::core::String])]
  :features
  [(start [self <- :probe::Tick2  req <- :probe::Tick2::StartRequest] -> :probe::Tick2::StartResponse
     :max-request-bytes 524288)
   (bump  [self <- :probe::Tick2  req <- :probe::Tick2::BumpRequest]  -> :probe::Tick2::BumpResponse
     :max-request-bytes 524288)])

(:wat::service::defservice :probe::tick2
  :satisfies :probe::Tick2
  :durable   [count <- :wat::core::i64]
  :ephemeral []
  :impls
  [;; ⛔ THE OFFENDING FORM — arms `bump`, a PUBLIC op, via its explicit `<service>::Op` ctor.
   (start [s ctx req]
     (:wat::service::Outcome::Continue s (:wat::core::Some (:probe::Tick2::Reply::Start (:probe::Tick2::StartResponse::Ok)))
       (:wat::core::Vector :- [(:wat::service::Directed :- [:probe::Tick2::Reply])]) [(:wat::service::Alarm :after (:wat::time::Millisecond 5)
          :op (:probe::tick2::Op::Bump (:probe::Tick2::BumpRequest)))]))

   (bump [s ctx req]
     (:wat::service::Outcome::Continue s
       (:wat::core::Some (:probe::Tick2::Reply::Bump (:probe::Tick2::BumpResponse::Ok))) (:wat::core::Vector :- [(:wat::service::Directed :- [:probe::Tick2::Reply])]) (:wat::core::Vector :- [(:wat::service::Alarm :- [:probe::tick2::Op])])))

   ;; INTERNAL reactor op (leading dash) — present so the control (which arms THIS one
   ;; instead) is structurally identical apart from the one armed `:op` expression.
   (-tick [s ctx]
     (:wat::service::SelfOutcome::Continue s (:wat::core::Vector :- [(:wat::service::Directed :- [:probe::Tick2::Reply])]) (:wat::core::Vector :- [(:wat::service::Alarm :- [:probe::tick2::Op])])))])
