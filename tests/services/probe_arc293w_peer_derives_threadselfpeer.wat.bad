;; 255.30 — the two peer heads are one head. The old mobility wall (a
;; ThreadSelfPeer value must not satisfy a Peer parameter) is gone with the
;; type. This file stays red for the rule that replaced it: a struct on a
;; thread peer is refused.

(:wat::core::defstruct :probe::S [val <- :wat::core::i64])

(:wat::core::defn :user::main [] -> :wat::core::nil
  (:wat::core::let
    [_p (:wat::test::spawn-peer (:wat::spawn::thread)
          (:wat::core::fn [self <- (:wat::kernel::Peer :- [:probe::S :wat::core::i64])]
              -> :wat::core::nil
            nil))]
    nil))
