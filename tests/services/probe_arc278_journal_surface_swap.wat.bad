;; Arc 278 T1b.1 Journal surface — NEGATIVE: the wrong-response-type swap at the reply site.
;; Identical to the positive `probe_arc278_journal_surface.wat` sibling EXCEPT `write-metrics`
;; replies a `:wat::query::Store::PutResponse::Success` (a DIFFERENT enum, structurally similar —
;; both are zero-field `:Success` variants) instead of the declared
;; `:wat::telemetry'::Journal::WriteMetricsResponse`. `:wat::service::Outcome::Reply`'s second
;; parameter is typed to the op's declared response type (Store::PutResponse mirrors this same
;; pattern for its own satisfiers), so this must be a located `TypeMismatch` AT THE REPLY SITE —
;; never a runtime mismatch.
(:wat::service::defservice :probe::toy-journal-swap
  :satisfies :wat::telemetry::Journal
  :durable   []
  :ephemeral []
  :impls
  [(write-metrics [s ctx req]
     (:wat::service::Outcome.Reply {:state s :reply (:wat::query::Store::PutResponse.Success {})}))
   (write-logs [s ctx req]
     (:wat::service::Outcome.Reply {:state s :reply (:wat::telemetry::Journal::WriteLogsResponse.Success {})}))
   ;; correct — so the ONLY defect is write-metrics' swapped reply type above.
   (query-metrics [s ctx req]
     (:wat::service::Outcome.Reply {:state s
       :reply (:wat::telemetry::Journal::QueryMetricsResponse.Success
         {:metrics (:wat::core::Vector :- [:wat::telemetry::Metric]) :cursor :wat::core::Option.None})}))
   (query-logs [s ctx req]
     (:wat::service::Outcome.Reply {:state s
       :reply (:wat::telemetry::Journal::QueryLogsResponse.Success
         {:logs (:wat::core::Vector :- [:wat::telemetry::Log]) :cursor :wat::core::Option.None})}))])
